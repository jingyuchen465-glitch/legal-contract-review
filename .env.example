NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://legalagent:change-this-password@127.0.0.1:5432/legalagent
DATA_ROOT=D:/LegalAgentData
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_SECRET=replace-with-another-32-random-characters
PUBLIC_URL=http://localhost:8080
MODEL_BASE_URL=https://api.example.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_CONCURRENCY=2
# 单个 Worker 进程内逐项审查的模型请求总并发（1–8）；与任务并发分开。
MODEL_REVIEW_CONCURRENCY=3
# 新预审每批审查点数（1–10），固定到本次预审；已有任务沿用原方案。
MODEL_REVIEW_RULE_BATCH_SIZE=8
# 整个模型请求 JSON 的 UTF-8 字节预算；含正文、规则、附件、知识及提示词。
# 不是模型上下文 token 数，须按实际模型能力设置；另外预留校验反馈空间。
MODEL_REVIEW_INPUT_BUDGET_BYTES=128000
MODEL_TIMEOUT_MS=120000
MODEL_REVIEW_TIMEOUT_MS=300000
# Harness 首次实际内容等待沿用上述时限；开始生成后改用停滞时限。
MODEL_REVIEW_IDLE_TIMEOUT_MS=120000
# 单次请求总时长上限；整轮仍受 AGENT_MAX_MINUTES 限制。
MODEL_REVIEW_MAX_DURATION_MS=900000
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.14.0
JEV_API_KEY=
EMBEDDING_MODEL=
OCR_URL=http://127.0.0.1:8090
OCR_TOKEN=replace-with-internal-service-token
ONLYOFFICE_URL=http://localhost:8081
ONLYOFFICE_INTERNAL_URL=http://127.0.0.1:8081
ONLYOFFICE_JWT_SECRET=replace-with-at-least-32-random-characters
BACKEND_URL_FOR_DOCKER=http://host.docker.internal:3000
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_COLLECTION=legal_agent_published_v1
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_OPERATOR_ID=
TRUST_PROXY_HOPS=0
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
PG_DUMP_PATH=
PG_RESTORE_PATH=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
# Office 自动转换（生产使用独立 converter 容器）
CONVERTER_URL=http://127.0.0.1:8091
CONVERTER_TOKEN=replace-with-at-least-32-random-characters
CONVERTER_TIMEOUT_MS=300000
# 完成迁移、模型验收和容量检查后开放 PDF 视觉识别及 Word 转换
PDF_WORD_ENABLED=false
# 本机开发可指定 Python 与 LibreOffice 可执行文件
# CONVERTER_PYTHON=C:/path/to/python.exe
# SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.com

# 分类建议中心及累积发布；迁移014并完成样本验证后开启
LEARNING_CATALOG_ENABLED=false

# Agent：固定官方 Harness 运行时；默认通过 npm run harness:build 构建
# LEGAL_HARNESS_ROOT=C:/path/to/.local/legal-harness
AGENT_MAX_REQUESTS=40
AGENT_MAX_MINUTES=30
AGENT_CONTEXT_WINDOW=128000
AGENT_MAX_OUTPUT_TOKENS=12000
AGENT_THINKING_FORMAT=openai
AGENT_REASONING=false
# 可在管理界面加密保存；未配置时显示检索限制
BRAVE_SEARCH_API_KEY=
